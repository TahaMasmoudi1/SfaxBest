<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="560.0" prefWidth="960.0" stylesheets="@../../../Styles/Admin.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.openjfx.sfaxbest.DocumantaryController">

    <left>
        <VBox alignment="TOP_CENTER" maxWidth="238.0" minWidth="238.0" prefHeight="560.0" prefWidth="238.0" spacing="0" styleClass="sidebar" BorderPane.alignment="TOP_LEFT">
            <padding>
                <Insets bottom="24.0" top="24.0" />
            </padding>
            <ImageView fitHeight="90.0" fitWidth="100.0">
                <image>
                    <Image url="@../../../icons/Adminlogo.png" />
                </image>
                <VBox.margin>
                    <Insets top="15.0" />
                </VBox.margin>
            </ImageView>

            <Separator prefWidth="160.0" style="-fx-opacity: 0.25;">
                <VBox.margin><Insets bottom="10.0" top="4.0" /></VBox.margin>
            </Separator>

            <Button alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#gotoDashboard" styleClass="sidebar-button" text="▸  Dashboard" textFill="WHITE" VBox.vgrow="NEVER">
                <VBox.margin>
                    <Insets top="-10.0" />
                </VBox.margin>
            </Button>

            <VBox spacing="0.0" styleClass="submenu">
                <Button alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="sidebar-button" text="▸  Content" textFill="WHITE" VBox.vgrow="NEVER" />
                <VBox spacing="0">
                    <Button alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" onAction="#goToFilms" styleClass="submenu-button" text="Films">
                        <font><Font size="13.0" /></font>
                    </Button>
                    <Button alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" onAction="#goToSeries" styleClass="submenu-button" text="Series" />
                    <Button fx:id="documentarybtn" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" styleClass="submenu-button" text="Documentary" />
                </VBox>
            </VBox>
            <Button alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#goToComments" styleClass="sidebar-button" text="▸  Comments" textFill="WHITE" VBox.vgrow="NEVER" />
            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </left>

    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" vbarPolicy="NEVER" BorderPane.alignment="CENTER">
            <content>
                <VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" spacing="14.0" styleClass="content">

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #f0f0f0; -fx-font-family: 'Trebuchet MS';" text="Documentaries" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #555555; -fx-font-family: 'Trebuchet MS';" text="Manage your documentary library" />
                    </HBox>

                    <TableView fx:id="movieTable" fixedCellSize="34" maxHeight="340.0" minWidth="-Infinity" prefHeight="200.0" styleClass="movie-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colId" prefWidth="32" text="ID" />
                            <TableColumn fx:id="colTitle" prefWidth="97" text="Title" />
                            <TableColumn fx:id="colDescription" prefWidth="130" text="Description" />
                            <TableColumn fx:id="colReleaseDate" prefWidth="54" text="Year" />
                            <TableColumn fx:id="colTrailer" prefWidth="54" text="Trailer" />
                            <TableColumn fx:id="colBanner" prefWidth="54" text="Banner" />
                            <TableColumn fx:id="colDuration" prefWidth="59" text="Duration" />
                            <TableColumn fx:id="colVideo" prefWidth="59" text="Video" />
                            <TableColumn fx:id="colCategorie" prefWidth="59" text="Categories" />
                            <TableColumn fx:id="colPoster" prefWidth="59" text="Poster" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>

                    <HBox alignment="CENTER" spacing="10.0" styleClass="action-bar">
                        <Button onAction="#addDocumantary" styleClass="primary-button" text="＋  Add" />
                        <Button onAction="#editDocumantary" styleClass="secondary-button" text="✎  Edit" />
                        <Button onAction="#handleDelete" styleClass="danger-button" text="✕  Delete" />
                    </HBox>

                    <ScrollPane fx:id="scrollForm" fitToHeight="true" fitToWidth="true" minWidth="200.0" vbarPolicy="NEVER" visible="false">
                        <content>
                            <VBox fx:id="form" alignment="TOP_CENTER" prefHeight="621.0" prefWidth="566.0" spacing="10.0" styleClass="form-box" visible="false">
                                <children>
                                    <Label styleClass="form-section-label" text="TITLE" />
                                    <TextField fx:id="tfTitle" promptText="Enter documentary title" />
                                    <Label fx:id="errTitle" styleClass="error-label" visible="false" managed="false"/>
                                    <Label styleClass="form-section-label" text="DESCRIPTION" />
                                    <TextArea fx:id="taDescription" prefRowCount="3" promptText="Enter description" />
                                    <Label fx:id="errDescription" styleClass="error-label" visible="false" managed="false"/>
                                    <HBox spacing="12.0">
                                        <children>
                                            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                                <children>
                                                    <Label styleClass="form-section-label" text="RELEASE YEAR" />
                                                    <TextField fx:id="tfReleaseYear" promptText="e.g. 2024" />
                                                    <Label fx:id="errReleaseYear" styleClass="error-label" visible="false" managed="false"/>
                                                </children>
                                            </VBox>
                                            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                                <children>
                                                    <Label styleClass="form-section-label" text="DURATION (min)" />
                                                    <TextField fx:id="tfDuration" promptText="e.g. 120" />
                                                    <Label fx:id="errDuration" styleClass="error-label" visible="false" managed="false"/>
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>
                                    <Label styleClass="form-section-label" text="TRAILER" />
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <TextField fx:id="tfTrailer" editable="false"
                                                   promptText="Trailer file path" HBox.hgrow="ALWAYS" />
                                        <Label fx:id="errTrailer" styleClass="error-label" visible="false" managed="false"/>
                                        <Button styleClass="browse-button" text="Browse…"
                                                onAction="#browseTrailer" />
                                    </HBox>

                                    <!-- BANNER -->
                                    <Label styleClass="form-section-label" text="BANNER" />
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <TextField fx:id="tfBanner" editable="false"
                                                   promptText="Banner file path" HBox.hgrow="ALWAYS" />
                                        <Label fx:id="errBanner" styleClass="error-label" visible="false" managed="false"/>
                                        <Button styleClass="browse-button" text="Browse…"
                                                onAction="#browseBanner" />
                                    </HBox>

                                    <!-- VIDEO -->
                                    <Label styleClass="form-section-label" text="VIDEO" />
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <TextField fx:id="tfVideo" editable="false"
                                                   promptText="Video file path" HBox.hgrow="ALWAYS" />
                                        <Label fx:id="errVideo" styleClass="error-label" visible="false" managed="false"/>
                                        <Button styleClass="browse-button" text="Browse…"
                                                onAction="#browseVideo" />
                                    </HBox>

                                    <!-- POSTER -->
                                    <Label styleClass="form-section-label" text="POSTER" />
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <TextField fx:id="tfPoster" editable="false"
                                                   promptText="Poster file path" HBox.hgrow="ALWAYS" />
                                        <Label fx:id="errPoster" styleClass="error-label" visible="false" managed="false"/>
                                        <Button styleClass="browse-button" text="Browse…"
                                                onAction="#browsePoster" />
                                    </HBox>
                                    <Label styleClass="form-section-label" text="CATEGORIES" />
                                    <GridPane fx:id="checkboxGrid" alignment="CENTER" hgap="30.0" vgap="40.0">
                                        <padding>
                                            <Insets bottom="10" left="10" right="10" top="10" />
                                        </padding>
                                    </GridPane>
                                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                        <VBox.margin>
                                            <Insets top="8.0" />
                                        </VBox.margin>
                                        <children>
                                            <Button fx:id="edit2btn" onAction="#editing" styleClass="secondary-button" text="✎  Save Changes" visible="false" />
                                            <Button fx:id="add2btn" onAction="#adding" styleClass="primary-button" text="＋  Add Documentary" visible="false" />
                                            <Button styleClass="danger-button" text="✕  Delete" />
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>
                        </content>
                    </ScrollPane>

                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
