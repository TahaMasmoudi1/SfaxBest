<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.openjfx.sfaxbest.MoviePosterController"
           styleClass="poster-card">

    <ImageView
            fx:id="posterImage"
            fitWidth="160"
            fitHeight="240"
            preserveRatio="false"
            styleClass="movie-card"/>

    <VBox fx:id="overlay"
          styleClass="poster-overlay"
          visible="false">

        <Label fx:id="titleLabel" styleClass="poster-title"/>
        <Label fx:id="genreLabel" styleClass="poster-genre"/>
        <Label fx:id="ratingLabel" styleClass="poster-rating"/>

    </VBox>

</StackPane>
