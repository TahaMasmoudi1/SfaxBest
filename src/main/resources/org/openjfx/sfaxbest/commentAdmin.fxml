<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!--
    SfaxBest — Comment Moderation Panel
    CSS  : comment.css  (same folder)
    All original fx:id values are UNCHANGED.
    Added: search bar, filter pills, detail panel, moderation buttons.
-->

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="580.0" prefWidth="860.0" stylesheets="@../../../Styles/comment.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.openjfx.sfaxbest.CommentController">

    <!-- ════════════════════════════════════════════
         LEFT — SIDEBAR
    ════════════════════════════════════════════ -->
    <left>
        <VBox alignment="TOP_CENTER" maxWidth="220.0" minWidth="238.0" prefHeight="560.0" prefWidth="238.0" spacing="0" styleClass="sidebar" BorderPane.alignment="TOP_LEFT">

            <padding><Insets bottom="24.0" top="24.0" /></padding>

            <Separator prefWidth="160.0" style="-fx-opacity: 0.25;">
                <VBox.margin><Insets bottom="10.0" top="4.0" /></VBox.margin>
            </Separator>
         <ImageView fitHeight="90.0" fitWidth="100.0">
            <image>
               <Image url="@../../../icons/Adminlogo.png" />
            </image>
         </ImageView>

            <!-- Dashboard -->
            <Button alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#goToDashbaord" styleClass="sidebar-button" text="⬛  Dashboard" textFill="WHITE" VBox.vgrow="NEVER" />

            <!-- Content submenu -->
            <VBox spacing="0" styleClass="submenu">
                <Button alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="sidebar-button" text="▸  Content" textFill="WHITE" VBox.vgrow="NEVER" />
                <VBox spacing="0">
                    <Button fx:id="filmbtn" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" onAction="#goToFilms" styleClass="submenu-button" text="Films">
                        <font><Font size="13.0" /></font>
                    </Button>
                    <Button alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" onAction="#goToSeries" styleClass="submenu-button" text="Series" />
                    <Button fx:id="documentarybtn" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" onAction="#goToDocumantary" styleClass="submenu-button" text="Documentary" />
                </VBox>
            </VBox>

            <!-- Multimedia -->
            <Button alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="sidebar-button" text="▸  Multimedia" textFill="WHITE" VBox.vgrow="NEVER" />

            <!-- Comments — ACTIVE -->
            <Button alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="sidebar-button" text="▸  Comments" VBox.vgrow="NEVER" />

            <!-- Users -->
            <Button alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="sidebar-button" text="▸  Users" textFill="WHITE" VBox.vgrow="NEVER" />

            <Region VBox.vgrow="ALWAYS" />
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>

        </VBox>
    </left>

    <!-- ════════════════════════════════════════════
         CENTER — COMMENT MODERATION CONTENT
    ════════════════════════════════════════════ -->
    <center>
        <VBox alignment="TOP_LEFT" prefWidth="660.0" spacing="12.0" styleClass="content" BorderPane.alignment="CENTER">

            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

            <!-- ── Page heading ── -->
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label styleClass="page-title" text="Comment Moderation" />
                <Region HBox.hgrow="ALWAYS" />
                <Label styleClass="page-subtitle" text="Review · Warn · Ban · Dismiss" />
            </HBox>

            <!-- ── Comment table (all original fx:ids preserved) ── -->
            <TableView fx:id="commentTable" fixedCellSize="36" maxHeight="1.7976931348623157E308" styleClass="comment-table" VBox.vgrow="ALWAYS">

                <columns>
                    <TableColumn fx:id="colIdComment" text="FILM ID" />
                    <TableColumn fx:id="colTitleFilm" text="FILM" />
                    <TableColumn fx:id="colIDuser" text="USER ID" />
                    <TableColumn fx:id="coluserName" text="USER" />
                    <TableColumn fx:id="colComment" text="COMMENT" />
                    <TableColumn fx:id="colNumberRep" text="REPORTS" />
                </columns>

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <!-- ── Detail panel (shown on row select) ── -->
            <VBox fx:id="form" spacing="10.0" styleClass="detail-panel" visible="false">

                <!-- detail header row -->
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="detail-section-label" text="SELECTED COMMENT" />
                        <!-- reuse tfTitle as "user display" field -->
                        <TextField fx:id="tfTitle" editable="false" maxWidth="1.7976931348623157E308" promptText="User — Film title" styleClass="search-field" />
                    </VBox>

                    <!-- report count badge area -->
                    <VBox alignment="CENTER" spacing="4.0">
                        <Label styleClass="detail-section-label" text="REPORTS" />
                        <!-- reuse tfReleaseYear as report count display -->
                        <HBox alignment="CENTER" styleClass="report-badge">
                            <TextField fx:id="tfReleaseYear" editable="false" promptText="0" style="-fx-background-color: transparent; -fx-border-color: transparent;                                        -fx-text-fill: #e50914; -fx-font-weight: bold;                                        -fx-font-size: 14px; -fx-pref-width: 50px;                                        -fx-alignment: center;" />
                        </HBox>
                    </VBox>
                </HBox>

                <!-- comment body -->
                <VBox spacing="6.0">
                    <Label styleClass="detail-section-label" text="COMMENT CONTENT" />
                    <TextArea fx:id="taDescription" editable="false" maxWidth="1.7976931348623157E308" prefRowCount="3" promptText="Comment text will appear here…" style="-fx-background-color: #141414; -fx-border-color: #2a2a2a;                                -fx-border-radius: 6; -fx-background-radius: 6;                                -fx-text-fill: #cccccc; -fx-font-size: 13px;                                -fx-control-inner-background: #141414;" styleClass="search-field" wrapText="true" />
                </VBox>

                <!-- extra meta row  (reuse tfDuration / tfTrailer / tfBanner / tfVideo as meta fields) -->
                <HBox spacing="12.0">
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="detail-section-label" text="FILM ID" />
                        <TextField fx:id="tfDuration" editable="false" maxWidth="1.7976931348623157E308" promptText="—" styleClass="search-field" />
                    </VBox>
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="detail-section-label" text="USER ID" />
                        <TextField fx:id="tfTrailer" editable="false" maxWidth="1.7976931348623157E308" promptText="—" styleClass="search-field" />
                    </VBox>
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="detail-section-label" text="DATE" />
                        <TextField fx:id="tfBanner" editable="false" maxWidth="1.7976931348623157E308" promptText="—" styleClass="search-field" />
                    </VBox>
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="detail-section-label" text="STATUS" />
                        <TextField fx:id="tfVideo" editable="false" maxWidth="1.7976931348623157E308" promptText="Active" styleClass="search-field" />
                    </VBox>
                </HBox>

            </VBox>

            <!-- ── Moderation action bar ── -->
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="action-bar">

                <!-- Warn button -->
                <Button fx:id="edit2btn" mnemonicParsing="false" styleClass="warn-button" text="⚠  Warn User" />

                <!-- Ban button -->
                <Button fx:id="add2btn" mnemonicParsing="false" styleClass="ban-button" text="🚫  Ban User" />

                <!-- Dismiss button -->
                <Button mnemonicParsing="false" styleClass="dismiss-button" text="✓  Dismiss Report" />

                <Region HBox.hgrow="ALWAYS" />

                <!-- Delete comment -->
                <Button mnemonicParsing="false" styleClass="delete-button" text="✕  Delete Comment" />

            </HBox>

        </VBox>
    </center>

</BorderPane>
