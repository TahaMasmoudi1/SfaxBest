<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="560.0" prefWidth="960.0"
            stylesheets="@../../../Styles/Admin.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.openjfx.sfaxbest.SerieController">

    <left>
        <VBox alignment="TOP_CENTER" maxWidth="238.0" minWidth="238.0"
              prefHeight="560.0" prefWidth="238.0"
              spacing="0" styleClass="sidebar" BorderPane.alignment="TOP_LEFT">
            <padding><Insets top="24.0" bottom="24.0"/></padding>
            <ImageView fitHeight="90.0" fitWidth="100.0">
                <image><Image url="@../../../icons/Adminlogo.png"/></image>
                <VBox.margin><Insets top="15.0"/></VBox.margin>
            </ImageView>
            <Separator prefWidth="160.0" style="-fx-opacity: 0.25;">
                <VBox.margin><Insets bottom="10.0" top="4.0"/></VBox.margin>
            </Separator>
            <Button alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308"
                    mnemonicParsing="false" onAction="#gotoDashboard"
                    styleClass="sidebar-button" text="▸  Dashboard" textFill="WHITE" VBox.vgrow="NEVER">
                <VBox.margin><Insets top="-10.0"/></VBox.margin>
            </Button>
            <VBox spacing="0.0" styleClass="submenu">
                <Button alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308"
                        mnemonicParsing="false" styleClass="sidebar-button"
                        text="▸  Content" textFill="WHITE" VBox.vgrow="NEVER"/>
                <VBox spacing="0">
                    <Button fx:id="filmbtn" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308"
                            onAction="#goToFilms" styleClass="submenu-button" text="Films">
                        <font><Font size="13.0"/></font>
                    </Button>
                    <Button alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308"
                            onAction="#backToSeries" styleClass="submenu-button" text="Series"/>
                    <Button fx:id="documentarybtn" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308"
                            onAction="#goToDocumantary" styleClass="submenu-button" text="Documentary"/>
                </VBox>
            </VBox>
            <Button alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308"
                    mnemonicParsing="false" onAction="#goToComments"
                    styleClass="sidebar-button" text="▸  Comments" textFill="WHITE" VBox.vgrow="NEVER"/>
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" vbarPolicy="AS_NEEDED" BorderPane.alignment="CENTER">
            <content>
                <VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308"
                      maxWidth="1.7976931348623157E308" spacing="14.0" styleClass="content">

                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Button styleClass="browse-button" text="‹  Back to Series" onAction="#backToSeries"/>
                        <Label style="-fx-text-fill:#444444;-fx-font-size:13px;-fx-font-family:'Trebuchet MS';" text="›"/>
                        <Label fx:id="lblSerieName"
                               style="-fx-font-size:20px;-fx-font-weight:bold;-fx-text-fill:#f0f0f0;-fx-font-family:'Trebuchet MS';"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label style="-fx-font-size:12px;-fx-text-fill:#555555;-fx-font-family:'Trebuchet MS';" text="Manage Seasons"/>
                    </HBox>

                    <TableView fx:id="seasonTable" fixedCellSize="34" maxHeight="340.0"
                               prefHeight="200.0" styleClass="movie-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colSeasonId"      text="ID"       />
                            <TableColumn fx:id="colSeasonNumber"  text="Season #" />
                            <TableColumn fx:id="colSeasonBanner"  text="Banner"   />
                            <TableColumn fx:id="colSeasonTrailer" text="Trailer" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="action-bar">
                        <Button styleClass="primary-button"   text="＋  Add Season"    onAction="#addSeasonAction"/>
                        <Button styleClass="secondary-button" text="✎  Edit Season"    onAction="#editSeasonAction"/>
                        <Button styleClass="danger-button"    text="✕  Delete Season"  onAction="#handleDeleteSeason"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button styleClass="secondary-button" text="🎬  Episodes ›"    onAction="#goToEpisodes"/>
                    </HBox>

                    <VBox fx:id="seasonForm" alignment="TOP_CENTER" spacing="10.0"
                          styleClass="form-box" visible="false" managed="false">
                        <Label styleClass="form-section-label" text="SEASON NUMBER"/>
                        <TextField fx:id="tfSeasonNumber" promptText="e.g. 1"/>
                        <Label styleClass="form-section-label" text="BANNER"/>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <TextField fx:id="tfSeasonBanner" editable="false"
                                       promptText="Banner path" HBox.hgrow="ALWAYS"/>
                            <Button styleClass="browse-button" text="Browse…" onAction="#browseSeasonBanner"/>
                        </HBox>
                        <Label styleClass="form-section-label" text="TRAILER"/>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <TextField fx:id="tfSeasonTrailer" editable="false"
                                       promptText="Trailer path" HBox.hgrow="ALWAYS"/>
                            <Button styleClass="browse-button" text="Browse…" onAction="#browseSeasonTrailer"/>
                        </HBox>
                        <HBox spacing="10.0" alignment="CENTER_RIGHT">
                            <VBox.margin><Insets top="8.0"/></VBox.margin>
                            <Button fx:id="editSeasonBtn" styleClass="secondary-button"
                                    text="✎  Save Season" onAction="#editingSeasonAction"
                                    visible="false" managed="false"/>
                            <Button fx:id="addSeasonBtn" styleClass="primary-button"
                                    text="＋  Add Season" onAction="#addingSeasonAction"
                                    visible="false" managed="false"/>
                        </HBox>
                    </VBox>

                </VBox>
            </content>
            <BorderPane.margin><Insets/></BorderPane.margin>
        </ScrollPane>
    </center>

</BorderPane>
