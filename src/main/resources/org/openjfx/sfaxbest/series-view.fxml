<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>


<?import javafx.scene.control.ComboBox?>
<ScrollPane fitToWidth="true" style="-fx-background-color: #202020;" stylesheets="@../../../Styles/movie-style.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.openjfx.sfaxbest.SeriesViewController" prefHeight="Infinity" prefWidth="Infinity">

    <VBox spacing="20" style="-fx-background-color: #202020;">

        <StackPane fx:id="bannerContainer" prefHeight="400.0">

            <ImageView fx:id="bannerImage" preserveRatio="false"/>
            <StackPane style="-fx-background-color: linear-gradient(to bottom, transparent 60%, #202020 100%);" />

        </StackPane>

        <VBox spacing="15">
            <padding>
                <Insets bottom="20" left="40" right="40" top="0" />
            </padding>

            <Label fx:id="titleLabel" styleClass="title" text="Movie Title"/>

            <HBox spacing="15">
                <Label fx:id="ratingLabel" style="-fx-text-fill: #FFD700; -fx-font-size: 16px;" text="★ 4.5/5" />
                <Label fx:id="durationLabel" style="-fx-text-fill: #AAAAAA; -fx-font-size: 16px;" text="120 min" />
            </HBox>

            <HBox spacing="15">
                <Button  styleClass="primary-btn" text="✚ Add to Watchlist" onMouseClicked="#addToFavorites"/>
                <Region HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="seasonFilter" promptText="Season" styleClass="filter-combo" prefWidth="150" maxHeight="15"/>
            </HBox>
            <VBox spacing="10">

                <Label styleClass="section-title" text="Action" />

                <ScrollPane hbarPolicy="AS_NEEDED" pannable="true" prefHeight="280" vbarPolicy="NEVER">

                    <HBox fx:id="episodesPosterRow" prefHeight="240" spacing="20">

                        <!-- the content is allocated dynamically-->

                    </HBox>
                </ScrollPane>
            </VBox>

            <Label fx:id="castLabel" styleClass="cast-text" text="Cast: Actor 1, Actor 2" />


            <Label fx:id="descriptionLabel" style="-fx-text-fill: white; -fx-font-size: 14px;" text="Movie description goes here..." wrapText="true" />
        </VBox>

        <VBox spacing="15">
            <padding>
                <Insets bottom="40" left="40" right="40" top="20" />
            </padding>

            <Label style="-fx-font-size: 24px; -fx-text-fill: white; -fx-font-weight: bold;" text="Rate &amp; Review" />

            <HBox fx:id="starRatingBox" spacing="5">
                <Label text="☆" styleClass="rate-star"/>
                <Label text="☆" styleClass="rate-star"/>
                <Label text="☆" styleClass="rate-star"/>
                <Label text="☆" styleClass="rate-star"/>
                <Label text="☆" styleClass="rate-star"/>
            </HBox>

            <TextArea fx:id="commentInput" prefHeight="80.0" prefRowCount="3" promptText="Write your review here..." wrapText="true" />
            <Button onMouseClicked="#addComment" styleClass="primary-btn" text="Submit Review" />

            <Label styleClass="comments" text="Recent Comments" />
            <VBox fx:id="commentsContainer" style="-fx-background-color:#202020; " spacing="10" >
                <!-- comments are loaded dynamically -->
            </VBox>

        </VBox>
    </VBox>
</ScrollPane>



