            <Button contentDisplay="CENTER" maxWidth="500.0" minHeight="30.0" mnemonicParsing="false" opacity="0.85" prefHeight="50.0" style="-fx-font-weight: bold;" styleClass="sidebar-button" text="Comments" textAlignment="CENTER" textFill="WHITE" VBox.vgrow="SOMETIMES">
