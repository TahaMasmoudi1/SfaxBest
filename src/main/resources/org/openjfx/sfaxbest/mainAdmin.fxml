             </VBox>
            <Button alignment="CENTER" contentDisplay="CENTER" maxWidth="500.0" minHeight="30.0" mnemonicParsing="false" opacity="0.85" prefHeight="50.0" prefWidth="106.0" style="-fx-font-weight: bold;" styleClass="sidebar-button" text="Multimedia" textAlignment="CENTER" textFill="WHITE" VBox.vgrow="SOMETIMES">
               <VBox.margin>
                  <Insets />
